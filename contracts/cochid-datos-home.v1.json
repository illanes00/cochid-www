{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "1.0.0",
  "consumer": "cochid-home",
  "producer": "cochid-datos",
  "base_url": "https://datos.cochid.cl",
  "resources": {
    "platform_health": {
      "method": "GET",
      "url": "https://datos.cochid.cl/api/health/deep",
      "ttl_seconds": 300,
      "required_fields": [
        "service",
        "db_ok",
        "datasets_registered",
        "last_ingestion.status",
        "last_ingestion.started_at",
        "status"
      ],
      "observation_field": "last_ingestion.started_at",
      "freshness_threshold_seconds": 172800,
      "fallback": "Estado de la plataforma no disponible; mantener enlaces al catálogo y estado."
    },
    "themes": {
      "method": "GET",
      "url": "https://datos.cochid.cl/api/temas/",
      "ttl_seconds": 3600,
      "required_fields": [
        "[].slug",
        "[].name",
        "[].description"
      ],
      "observation_field": null,
      "freshness_threshold_seconds": 86400,
      "fallback": "Conteo de temas no disponible; mantener acceso al explorador de temas."
    },
    "budget_composition": {
      "method": "GET",
      "url": "https://datos.cochid.cl/api/cofog/composition?year=2024",
      "ttl_seconds": 86400,
      "required_fields": [
        "[].code",
        "[].name_es",
        "[].gasto_corriente",
        "[].pct_pib",
        "[].pct_gasto_total"
      ],
      "observation_field": "query.year",
      "freshness_threshold_seconds": 0,
      "fallback": "Composición presupuestaria no disponible; enlazar la vista completa en Datos."
    }
  }
}
